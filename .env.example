# Copy to .env (gitignored at the repo root -- see /home/ashwinkm/C-AIMMS/.gitignore)
# and fill in real values. Never commit a filled-in .env.

# --- LLM endpoint (iterret/llm_client.py) -----------------------------------
# Used by config/llm/openai_compatible.yaml when base_url/model are left null.
ITERRET_LLM_BASE_URL=http://localhost:8000/v1
ITERRET_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Only needed for a real hosted endpoint; local vLLM servers ignore it.
ITERRET_LLM_API_KEY=not-needed

# --- Weights & Biases (iterret/exp_logging.py) ------------------------------
# Required only when wandb.enabled=true (config/config.yaml). Get a key at
# https://wandb.ai/authorize. Never commit this value.
WANDB_API_KEY=
# Optional: pin the entity/team if it's not your wandb default.
WANDB_ENTITY=

# --- Checkpoint storage (config/checkpoint/default.yaml) --------------------
# Large artifacts go under /mnt/ssd/users/durgesh/, never /home (CLAUDE.md
# storage invariants). Override per-environment.
ITERRET_CHECKPOINT_ROOT=/mnt/ssd/users/durgesh/iterret/checkpoints
